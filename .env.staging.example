# ==============================================================================
# CampusFlow STAGING Environment Variables Template
# ==============================================================================
# Copy these values into Vercel Staging/Preview Environment Variables.
# NEVER populate this with production credentials.
# ==============================================================================

# 1. Staging Supabase Credentials (NEW SEPARATE STAGING PROJECT)
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# 2. Application URL & Super Admin (STAGING HOST)
NEXT_PUBLIC_APP_URL=https://staging-campusflow.vercel.app
SUPER_ADMIN_EMAIL=staging-admin@campusflow.test

# 3. Google Workspace Integrations (STAGING DUMMIES / ISOLATED TEST ACCOUNT)
GOOGLE_CLIENT_ID=staging-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=staging-dummy-google-secret
GOOGLE_REDIRECT_URI=https://staging-campusflow.vercel.app/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=staging-dummy-refresh-token
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/staging-dummy-id/exec
GOOGLE_APPS_SCRIPT_SECRET=staging-dummy-webhook-secret
GOOGLE_APPS_SCRIPT_RUNNER_EMAIL=staging-runner@campusflow.test

# 4. Email & Notifications (STAGING SINK / DUMMY CREDENTIALS)
BREVO_API_KEY=xkeysib-staging-dummy-key
BREVO_SENDER_EMAIL=staging-notifications@campusflow.test
BREVO_SENDER_NAME=CampusFlow-Staging
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=staging-user
SMTP_PASS=staging-pass
RESEND_API_KEY=re_staging_dummy_key
EMAIL_FROM=CampusFlow Staging <staging@campusflow.test>
