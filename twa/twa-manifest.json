    },
    {
      "name": "Admin Console",
      "shortName": "Admin",
      "url": "https://143campusflow.vercel.app/admin/login",
      "chosenIconUrl": "https://143campusflow.vercel.app/icon-192.png"
    }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://143campusflow.vercel.app/manifest.webmanifest",
